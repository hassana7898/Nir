# ==========================================
# NIR Industrial Management System Configuration
# ==========================================

# Application Environment (development, production, test)
NODE_ENV=production

# Server Network Configuration (Port 3000 is required for LAN / factory PC)
PORT=3000
HOST=0.0.0.0

# Authoritative PostgreSQL Database URL
# Example: postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/nir_db
DATABASE_URL=

# JSON Web Token Secret for Authentication & Sessions (Minimum 32 random characters)
JWT_SECRET=

# Public API Base URL for Frontend/PWA clients
# Leave empty for same-origin (recommended), or set https://app.artadan.ir
VITE_API_BASE_URL=
API_BASE_URL=

# Cross-Origin Resource Sharing (comma-separated origins, or * for open LAN)
CORS_ORIGIN=
ALLOWED_ORIGINS=

# Cross-Site Cookie Policy (set to 1 when served through a reverse proxy / HTTPS)
CROSS_SITE_COOKIE=1

# Local File Storage Directories
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups

# Google Gemini API Key for Automated Invoice & Remittance Data Extraction (optional)
GEMINI_API_KEY=

# Optional Database Connection Pool Tuning
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
