# ==========================================
# NIR Industrial Management System Configuration
# ==========================================

# Application Environment (development, production, test)
NODE_ENV=production

# Server Network Configuration (Port 3000 is required for container & LAN environments)
PORT=3000
HOST=0.0.0.0

# Authoritative PostgreSQL Database URL
# Example: postgresql://postgres:your_secure_password@localhost:5432/nir_db
DATABASE_URL=

# JSON Web Token Secret for Authentication & Sessions (Minimum 32 random characters)
JWT_SECRET=

# Public API Base URL for Frontend/PWA/Firebase Clients
# Leave empty for same-origin, or specify http://192.168.1.100:3000 for LAN, or https://api.yourdomain.com
VITE_API_BASE_URL=
API_BASE_URL=

# Cross-Origin Resource Sharing (comma-separated origins or * for open LAN)
CORS_ORIGIN=
ALLOWED_ORIGINS=

# Cross-Site Cookie Policy (set to 1 when embedded in cross-site preview iframes)
CROSS_SITE_COOKIE=1

# Local File Storage Directories
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups

# Google Gemini API Key for Automated Invoice & Remittance Data Extraction
GEMINI_API_KEY=

# Optional Database Connection Pool Tuning
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
