{
  "name": "factory-remittance-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node -e \"const fs=require('fs');const p='dist/sw.js';if(fs.existsSync(p)) fs.writeFileSync(p, fs.readFileSync(p,'utf8').replace(/nir-cache-v[0-9.]+/, 'nir-cache-v' + Date.now()));\" && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:web": "vite build",
    "start": "node dist/server.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.42.0",
    "bcryptjs": "^3.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.43.0",
    "multer": "^2.3.0",
    "pdfjs-dist": "3.11.174",
    "pg": "^8.23.0",
    "react": "^18.2.0",
    "react-date-object": "^2.1.9",
    "react-dom": "^18.2.0",
    "react-multi-date-picker": "^4.4.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.12.7",
    "sortablejs": "^1.15.0",
    "sweetalert2": "^11.10.6",
    "uuid": "^14.0.2",
    "xlsx": "^0.18.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.3",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
